{
  "name": "Ditto connected test backend",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "forwardPorts": [8010],
  "portsAttributes": {"8010": {"label": "Ditto authenticated API", "onAutoForward": "notify"}},
  "postCreateCommand": "python -m venv .venv && .venv/bin/python -m pip install -r backend/requirements.txt",
  "postStartCommand": ".venv/bin/python backend/scripts/codespaces.py start",
  "remoteUser": "vscode",
  "customizations": {"vscode": {"extensions": ["ms-python.python"]}}
}
