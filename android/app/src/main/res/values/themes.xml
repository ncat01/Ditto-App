<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Ditto" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/ditto_background</item>
        <item name="android:navigationBarColor">@color/ditto_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.Ditto.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ditto_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_ditto_mark</item>
        <item name="windowSplashScreenAnimationDuration">400</item>
        <item name="postSplashScreenTheme">@style/Theme.Ditto</item>
    </style>
</resources>
