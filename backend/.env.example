# Ditto backend configuration.
# Copy to .env and fill in only what you have. Every provider below is optional:
# when a key is missing the backend falls back to Demo Mode for that capability
# and labels its output accordingly. NEVER commit a filled-in .env.

# Database. SQLite by default; swap for a PostgreSQL URL in production, e.g.
# postgresql+psycopg://ditto:password@localhost:5432/ditto
DITTO_DATABASE_URL=sqlite:///./ditto.db

# Force Demo Mode regardless of which keys are present.
DITTO_DEMO_MODE=true

# --- optional providers (all unset by default) ---
META_ACCESS_TOKEN=
GOOGLE_CLOUD_API_KEY=
META_AD_LIBRARY_TOKEN=
LLM_API_KEY=

# Sandboxed outreach. When unset, messages are recorded but never transmitted.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Private uploads; use persistent storage in a deployment.
DITTO_MEDIA_ROOT=./private_media
# Credentials above are reserved for future adapters; this build remains sandbox-only.
